# Konfigurasi Kunci API Model AI (OpenCode / OpenRouter / OpenAI)
# Di server lokal: salin berkas ini menjadi .env.local
# Di Vercel: masukkan variabel ini di menu Settings -> Environment Variables

OPENCODE_API_KEY=your_api_key_here
# Opsional: Jika menggunakan penyedia lain selain OpenRouter default
OPENCODE_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_MODEL=google/gemini-2.0-flash-001
